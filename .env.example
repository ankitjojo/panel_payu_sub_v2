# ── This test app ─────────────────────────────────────────────
PORT=3000

# ── Backend under test (jojo_subscription_backend_2_0) ────────
BACKEND_BASE_URL=http://localhost:8000

# ── Encryption: MUST match the backend's SECRET_KEY / IV (AES-256-CBC) ──
# SECRET_KEY = base64 of 32 bytes, IV = hex of 16 bytes. Kept server-side only, never sent to the browser.
SECRET_KEY=
IV=

# ── PayU page the browser posts to for UPI_VPA on the web ────
# Must match the backend's PAYU_ENVIRONMENT: PRODUCTION -> https://secure.payu.in/_payment, TEST -> https://test.payu.in/_payment
PAYU_PAYMENT_URL=https://secure.payu.in/_payment

# ── Headers the backend expects on every request ─────────────
PROJECT=jojo
DEVICE_TYPE=H0t30u
DEVICE_VERSION=1.0.0
DEVICE_ID=web-test-device-001

# ── Form defaults (all editable in the page) ─────────────────
# user-ip is what PayU receives as the client IP for UPI_QR; put your public IP here
DEFAULT_USER_IP=
DEFAULT_USER_AGENT=JojoAndroid/1.0 (Android 14; Test)
DEFAULT_PROVIDER_SKU_ID=
DEFAULT_USER_ID=
DEFAULT_USERNAME=Test User
DEFAULT_EMAIL=test@example.com
DEFAULT_PHONE=9999999999
DEFAULT_STATE=Gujarat
DEFAULT_CITY=Surat
